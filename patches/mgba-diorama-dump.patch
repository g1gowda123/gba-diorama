@@ -0,0 +1,319 @@
+/* Copyright (c) 2024 gba-diorama contributors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include <mgba/internal/gba/renderers/gl.h>
+
+#ifdef BUILD_GLES3
+
+#include <mgba/internal/gba/io.h>
+#include <mgba-util/vfs.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#ifdef _WIN32
+#include <direct.h>
+#endif
+
+#define DIORAMA_DUMP_DEFAULT_FRAME 120
+#define DIORAMA_DEFAULT_SEQ_STEP 30
+#define DIORAMA_PATH_MAX 1024
+
+static bool _joinPath(char* out, size_t size, const char* dir, const char* name) {
+	int len = snprintf(out, size, "%s/%s", dir, name);
+	return len > 0 && (size_t) len < size;
+}
+
+static bool _writeFile(const char* dir, const char* name, const void* data, size_t size) {
+	char path[DIORAMA_PATH_MAX];
+	if (!_joinPath(path, sizeof(path), dir, name)) {
+		fprintf(stderr, "gba-diorama: dump path too long: %s/%s\n", dir, name);
+		return false;
+	}
+	struct VFile* vf = VFileOpen(path, O_WRONLY | O_CREAT | O_TRUNC);
+	if (!vf) {
+		fprintf(stderr, "gba-diorama: could not open %s\n", path);
+		return false;
+	}
+	ssize_t written = vf->write(vf, data, size);
+	vf->close(vf);
+	if (written != (ssize_t) size) {
+		fprintf(stderr, "gba-diorama: short write to %s\n", path);
+		return false;
+	}
+	return true;
+}
+
+static bool _dirExists(const char* path) {
+#ifdef _WIN32
+	struct _stat st;
+	return _stat(path, &st) == 0 && (st.st_mode & _S_IFDIR);
+#else
+	struct stat st;
+	return stat(path, &st) == 0 && (st.st_mode & S_IFDIR);
+#endif
+}
+
+static bool _ensureDir(const char* path) {
+	if (_dirExists(path)) {
+		return true;
+	}
+#ifdef _WIN32
+	int rc = _mkdir(path);
+#else
+	int rc = mkdir(path, 0777);
+#endif
+	if (rc == 0 || _dirExists(path)) {
+		return true;
+	}
+	fprintf(stderr, "gba-diorama: could not create directory %s\n", path);
+	return false;
+}
+
+static unsigned _envUint(const char* name, unsigned fallback) {
+	const char* value = getenv(name);
+	if (!value || !*value) {
+		return fallback;
+	}
+	char* end = NULL;
+	unsigned long parsed = strtoul(value, &end, 0);
+	if (!end || *end != '\0') {
+		return fallback;
+	}
+	return (unsigned) parsed;
+}
+
+static bool _readLayer(GLuint fbo, int width, int height, bool flipY, uint8_t* out) {
+	glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+	GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+	if (status != GL_FRAMEBUFFER_COMPLETE) {
+		fprintf(stderr, "gba-diorama: FBO %u incomplete: 0x%04X\n", fbo, status);
+		return false;
+	}
+	while (glGetError() != GL_NO_ERROR) {
+	}
+	glPixelStorei(GL_PACK_ALIGNMENT, 1);
+	glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+	glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, out);
+	GLenum error = glGetError();
+	if (error != GL_NO_ERROR) {
+		fprintf(stderr, "gba-diorama: readback from FBO %u failed: 0x%04X\n", fbo, error);
+		return false;
+	}
+
+	/* Both BG and OBJ FBOs are already top-down. */
+	if (flipY) {
+		int stride = width * 4;
+		uint8_t* row = malloc(stride);
+		if (!row) {
+			return false;
+		}
+		int y;
+		for (y = 0; y < height / 2; ++y) {
+			uint8_t* top = out + y * stride;
+			uint8_t* bottom = out + (height - 1 - y) * stride;
+			memcpy(row, top, stride);
+			memcpy(top, bottom, stride);
+			memcpy(bottom, row, stride);
+		}
+		free(row);
+	}
+	return true;
+}
+
+static bool _dumpLayer(const char* dir, const char* name, GLuint fbo, int width, int height, bool flipY) {
+	size_t size = (size_t) width * height * 4;
+	uint8_t* pixels = malloc(size);
+	if (!pixels) {
+		return false;
+	}
+	bool ok = _readLayer(fbo, width, height, flipY, pixels);
+	if (ok) {
+		ok = _writeFile(dir, name, pixels, size);
+	}
+	free(pixels);
+	return ok;
+}
+
+/* Write one complete dump (metadata + VRAM/palette/OAM + BG/OBJ layers).
+ * `sequenceIndex` is < `sequenceCount` for sequence captures; pass a count of
+ * 0 for a one-off dump. */
+static void _dumpFrame(struct GBAVideoGLRenderer* renderer, const char* dir, unsigned frameIndex, unsigned sequenceIndex, unsigned sequenceCount, unsigned sequenceStep) {
+	int width = GBA_VIDEO_HORIZONTAL_PIXELS * renderer->scale;
+	int height = GBA_VIDEO_VERTICAL_PIXELS * renderer->scale;
+	int mode = GBARegisterDISPCNTGetMode(renderer->dispcnt);
+	int i;
+
+	char sequenceJson[160] = "";
+	if (sequenceCount > 0) {
+		snprintf(sequenceJson, sizeof(sequenceJson),
+			"  \"sequence\": {\"index\": %u, \"count\": %u, \"step\": %u},\n",
+			sequenceIndex, sequenceCount, sequenceStep);
+	}
+
+	char json[8192];
+	int offset = snprintf(json, sizeof(json),
+		"{\n"
+		"  \"format\": \"gba-diorama-dump\",\n"
+		"  \"version\": 1,\n"
+		"  \"frame\": %u,\n"
+		"  \"scale\": %d,\n"
+		"  \"screen\": [%d, %d],\n"
+		"  \"layer_size\": [%d, %d],\n"
+		"  \"flip_y\": false,\n"
+		"%s"
+		"  \"dispcnt\": %u,\n"
+		"  \"mode\": %d,\n"
+		"  \"blda\": %u,\n"
+		"  \"bldb\": %u,\n"
+		"  \"bldy\": %u,\n"
+		"  \"bg\": [\n",
+		frameIndex, renderer->scale,
+		GBA_VIDEO_HORIZONTAL_PIXELS, GBA_VIDEO_VERTICAL_PIXELS,
+		width, height,
+		sequenceJson,
+		(unsigned) renderer->dispcnt, mode,
+		(unsigned) renderer->blda, (unsigned) renderer->bldb, (unsigned) renderer->bldy);
+	if (offset < 0 || (size_t) offset >= sizeof(json)) {
+		fprintf(stderr, "gba-diorama: metadata buffer overflow\n");
+		return;
+	}
+
+	for (i = 0; i < 4; ++i) {
+		struct GBAVideoGLBackground* bg = &renderer->bg[i];
+		bool affine = (mode == 1 && i == 2) || (mode == 2 && i >= 2);
+		bool enabled = !!(renderer->dispcnt >> (8 + i) & 1);
+		offset += snprintf(json + offset, sizeof(json) - offset,
+			"    {\"index\": %d, \"enabled\": %s, \"priority\": %u, "
+			"\"char_base\": %u, \"screen_base\": %u, \"size\": %d, "
+			"\"bpp\": %d, \"scroll\": [%u, %u], \"affine\": %s}%s\n",
+			i, enabled ? "true" : "false", bg->priority,
+			bg->charBase, bg->screenBase, bg->size,
+			bg->multipalette ? 8 : 4, bg->x, bg->y,
+			affine ? "true" : "false", i == 3 ? "" : ",");
+		if (offset < 0 || (size_t) offset >= sizeof(json)) {
+			fprintf(stderr, "gba-diorama: metadata buffer overflow\n");
+			return;
+		}
+	}
+
+	offset += snprintf(json + offset, sizeof(json) - offset, "  ]\n}\n");
+	if (offset < 0 || (size_t) offset >= sizeof(json)) {
+		fprintf(stderr, "gba-diorama: metadata buffer overflow\n");
+		return;
+	}
+
+	if (!_writeFile(dir, "meta.json", json, (size_t) offset)) {
+		return;
+	}
+	if (renderer->d.vram) {
+		_writeFile(dir, "vram.bin", renderer->d.vram, 0x18000);
+	}
+	if (renderer->d.palette) {
+		_writeFile(dir, "palette.bin", renderer->d.palette, 0x400);
+	}
+	if (renderer->d.oam) {
+		_writeFile(dir, "oam.bin", renderer->d.oam, 0x400);
+	}
+
+	for (i = 0; i < 4; ++i) {
+		char name[16];
+		snprintf(name, sizeof(name), "bg%d.rgba", i);
+		if (!_dumpLayer(dir, name, renderer->bg[i].fbo, width, height, false)) {
+			fprintf(stderr, "gba-diorama: failed to dump BG%d\n", i);
+		}
+	}
+	if (!_dumpLayer(dir, "obj.rgba", renderer->fbo[GBA_GL_FBO_OBJ], width, height, false)) {
+		fprintf(stderr, "gba-diorama: failed to dump OBJ\n");
+	}
+
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+	fprintf(stderr, "gba-diorama: dumped frame %u to %s (%dx%d)\n", frameIndex, dir, width, height);
+}
+
+void GBADioramaDumpFrame(struct GBAVideoGLRenderer* renderer) {
+	static unsigned frame;
+	static bool singleDone;
+	static unsigned sequenceIndex;
+	static unsigned sequenceNext;
+	static bool sequenceStarted;
+
+	const char* dir = getenv("GBA_DIORAMA_DUMP_DIR");
+	if (!dir || !*dir) {
+		++frame;
+		return;
+	}
+
+	unsigned target = _envUint("GBA_DIORAMA_DUMP_FRAME", DIORAMA_DUMP_DEFAULT_FRAME);
+	unsigned sequenceCount = _envUint("GBA_DIORAMA_SEQ_COUNT", 0);
+	unsigned sequenceStep = _envUint("GBA_DIORAMA_SEQ_STEP", DIORAMA_DEFAULT_SEQ_STEP);
+	if (sequenceStep == 0) {
+		sequenceStep = 1;
+	}
+
+	/* Touch $GBA_DIORAMA_DUMP_DIR/trigger to capture the current frame
+	 * without restarting the emulator.  This is how menu/battle states are
+	 * captured after the initial frame target has already passed. */
+	char triggerPath[DIORAMA_PATH_MAX];
+	bool triggered = false;
+	if (_joinPath(triggerPath, sizeof(triggerPath), dir, "trigger")) {
+		struct VFile* trigger = VFileOpen(triggerPath, O_RDONLY);
+		if (trigger) {
+			trigger->close(trigger);
+			triggered = true;
+			remove(triggerPath);
+		}
+	}
+
+	unsigned current = frame++;
+
+	if (renderer->scale <= 0) {
+		fprintf(stderr, "gba-diorama: renderer scale is %d; launch with -C videoScale=2\n", renderer->scale);
+		return;
+	}
+
+	bool wantSingle = triggered || (!singleDone && current == target);
+	bool wantSequence = false;
+	if (sequenceCount > 0 && sequenceIndex < sequenceCount) {
+		if (!sequenceStarted) {
+			sequenceStarted = true;
+			sequenceNext = target;
+		}
+		wantSequence = current >= sequenceNext;
+	}
+
+	if (!wantSingle && !wantSequence) {
+		return;
+	}
+
+	if (wantSingle) {
+		if (!triggered) {
+			singleDone = true;
+		}
+		_dumpFrame(renderer, dir, current, 0, 0, 0);
+	}
+
+	if (wantSequence) {
+		char sequenceRoot[DIORAMA_PATH_MAX];
+		char frameDir[DIORAMA_PATH_MAX];
+		char frameName[32];
+		snprintf(frameName, sizeof(frameName), "%05u", current);
+		if (_joinPath(sequenceRoot, sizeof(sequenceRoot), dir, "seq") &&
+		    _ensureDir(sequenceRoot) &&
+		    _joinPath(frameDir, sizeof(frameDir), sequenceRoot, frameName) &&
+		    _ensureDir(frameDir)) {
+			_dumpFrame(renderer, frameDir, current, sequenceIndex, sequenceCount, sequenceStep);
+		}
+		++sequenceIndex;
+		sequenceNext = current + sequenceStep;
+		if (sequenceIndex >= sequenceCount) {
+			singleDone = true;
+		}
+	}
+}
+
+#endif
